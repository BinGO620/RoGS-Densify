+// 同一 int64 值逐位确定地转成 float（double 中间量，避免二次舍入差异）。
+__global__ void convert_det_kernel(const long long* __restrict__ src, float* __restrict__ dst, long long n)
+{
+	long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x;
+	if (i < n) {
+		dst[i] = (float)((double)src[i] / 16777216.0);
+	}
+}
+
+void BACKWARD::convert_det(const long long* src, float* dst, long long n)
+{
+	if (n <= 0) return;
+	const int threads = 256;
+	const long long blocks = (n + threads - 1) / threads;
+	convert_det_kernel << <(unsigned int)blocks, threads >> > (src, dst, n);
+}
